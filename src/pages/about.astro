---
// LEO 소개 페이지 — 단일 정적 페이지. 본문은 대표가 직접 채운다 (2026-09-05 구조 확정: 글이 쌓이는 카테고리 아님)
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR, SITE_TITLE, SOCIALS } from '../consts';

// 저자 엔티티(E-E-A-T·GEO)
const personLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	mainEntity: {
		'@type': 'Person',
		name: AUTHOR.name,
		alternateName: AUTHOR.alternateName,
		url: new URL('/about/', Astro.site).toString(),
		sameAs: Object.values(SOCIALS),
		worksFor: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.toString() },
	},
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`LEO — ${SITE_TITLE}`} description="LEOLAB80을 쓰는 LEO에 대하여" />
		<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
	</head>
	<body>
		<Header />
		<main class="prose about">
			<div class="post-head">
				<h1>LEO</h1>
				<div class="tick"></div>
			</div>
			<!-- 본문: 대표 작성 -->
		</main>
		<Footer />
	</body>
</html>

<style>
	.about {
		padding-top: 1rem;
		min-height: 40vh;
	}
	.post-head {
		text-align: center;
		padding: 2.4rem 0 1.5rem;
	}
	.post-head h1 {
		font-family: var(--font-display);
		font-size: 40px;
		letter-spacing: 0.16em;
		margin: 0.3em 0 0.5em;
	}
	.tick {
		width: 56px;
		border-top: 2px solid #000;
		margin: 1.4rem auto 0;
	}
</style>
