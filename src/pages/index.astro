---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CATEGORIES, CATEGORY_SLUG, SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const lead = posts[0];
const minis = posts.slice(1, 5);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${SITE_TITLE} — ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="wrap home">
			<h1 class="sr-only">{SITE_TITLE} — {SITE_TAGLINE}</h1>
			{
				lead && (
					<section>
						<h2 class="sec-head">최신 글</h2>
						<div class="latest">
							<a class="lead" href={`/blog/${lead.id}/`}>
								<div class="lead-img">
									{lead.data.heroImage && (
										<Image class="duotone" src={lead.data.heroImage} width={880} height={660} alt={lead.data.title} />
									)}
									<span class="badge">{lead.data.category}</span>
								</div>
								<h3 class="lead-title">{lead.data.title}</h3>
							</a>

							<div class="minis">
								{minis.map((p) => (
									<a class="mini" href={`/blog/${p.id}/`}>
										<div class="mini-img">
											{p.data.heroImage && (
												<Image class="duotone" src={p.data.heroImage} width={480} height={360} alt={p.data.title} />
											)}
											<span class="badge">{p.data.category}</span>
										</div>
										<h4 class="mini-title">{p.data.title}</h4>
									</a>
								))}
							</div>
						</div>
					</section>
				)
			}

			{
				CATEGORIES.map((cat) => {
					const list = posts.filter((p) => p.data.category === cat).slice(0, 3);
					if (list.length === 0) return null;
					return (
						<section>
							<div class="rule-thick" />
							<div class="sec-row">
								<h2 class="sec-head">{cat}</h2>
								<a class="more" href={`/category/${CATEGORY_SLUG[cat]}/`}>전체 보기 →</a>
							</div>
							<div class="cards">
								{list.map((p) => (
									<a class="card" href={`/blog/${p.id}/`}>
										<div class="card-img">
											{p.data.heroImage && (
												<Image class="duotone" src={p.data.heroImage} width={520} height={390} alt={p.data.title} />
											)}
											<span class="badge">{p.data.category}</span>
										</div>
										<h3 class="card-title">{p.data.title}</h3>
									</a>
								))}
							</div>
						</section>
					);
				})
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		padding: 2.4rem 0 0;
	}
	a {
		color: #000;
	}
	.sec-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
	}

	/* 최신 글: 대표 + 미니 그리드 */
	.latest {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: 36px;
		align-items: start;
	}
	.lead-img,
	.mini-img,
	.card-img {
		position: relative;
		border: 1px solid #000;
		overflow: hidden;
	}
	.lead-img {
		aspect-ratio: 4 / 3;
	}
	.lead-img :global(img),
	.mini-img :global(img),
	.card-img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.lead-title {
		font-size: 25px;
		line-height: 1.35;
		margin: 14px 0 0;
	}

	.minis {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
	}
	.mini-img {
		aspect-ratio: 4 / 3;
	}
	.mini-title {
		font-size: 15px;
		line-height: 1.45;
		margin: 10px 0 0;
	}

	/* 카테고리 카드 */
	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}
	.card-img {
		aspect-ratio: 4 / 3;
	}
	.card-title {
		font-size: 17px;
		line-height: 1.45;
		margin: 12px 0 0;
	}

	@media (max-width: 860px) {
		.latest {
			grid-template-columns: 1fr;
			gap: 28px;
		}
	}
	@media (max-width: 620px) {
		.cards {
			grid-template-columns: 1fr;
		}
		.minis {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
