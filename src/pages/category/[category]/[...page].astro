---
import { CATEGORIES, CATEGORY_SLUG } from '../../../consts';
import { getPosts } from '../../../lib/posts';
import CategoryView from '../../../views/CategoryView.astro';

export async function getStaticPaths({ paginate }) {
	const posts = await getPosts('ko');
	return CATEGORIES.flatMap((cat) => {
		const list = posts.filter((p) => p.category === cat);
		return paginate(list, { params: { category: CATEGORY_SLUG[cat] }, props: { cat }, pageSize: 8 });
	});
}

const { cat, page } = Astro.props;
---

<CategoryView lang="ko" cat={cat} page={page} />
