---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { CATEGORY_SLUG } from '../consts';
import { LANG_META, localizePath, t } from '../i18n';
import { getPosts, type Post } from '../lib/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, heroImage, lang, keyPoints } = post;
const ui = t(lang);
const categoryName = ui.categories[category];

// 공유 링크에 쓸 이 글의 정식 URL(사이트 도메인 + 현재 경로)
const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();

// 번역본이면 한국어 원문 주소 (JSON-LD translationOfWork)
const originalURL = lang === 'ko' ? undefined : new URL(`/blog/${post.id}/`, Astro.site).toString();

// 이동 경로: 홈 → 카테고리 → (현재 글)
const categoryURL = new URL(localizePath(`/category/${CATEGORY_SLUG[category]}/`, lang), Astro.site).toString();
const breadcrumb = [
	{ name: ui.home, url: new URL(localizePath('/', lang), Astro.site).toString() },
	{ name: categoryName, url: categoryURL },
	{ name: title },
];

const others = (await getPosts(lang)).filter((p) => p.id !== post.id);
const same = others.filter((p) => p.category === category);
const rest = others.filter((p) => p.category !== category);
const related = [...same, ...rest]
	.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf())
	.slice(0, 3);
---

<html lang={LANG_META[lang].htmlLang}>
	<head>
		<BaseHead
			title={`${title} — LEOLAB80`}
			description={description}
			image={heroImage}
			post={{ headline: title, pubDate, updatedDate, section: categoryName, keyPoints }}
				breadcrumb={breadcrumb}
			translationOf={originalURL}
			noindex={!post.reviewed}
		/>
	</head>
	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero">
							<Image
								class="duotone"
								src={heroImage}
								width={1200}
								height={675}
								alt={title}
								loading="eager"
								fetchpriority="high"
							/>
							<span class="badge">{categoryName}</span>
						</div>
					)
				}
				<div class="prose">
					<div class="post-head">
						<nav class="crumbs" aria-label={ui.crumbsLabel}>
								<a href={localizePath('/', lang)}>{ui.home}</a>
								<span aria-hidden="true">›</span>
								<a href={categoryURL}>{categoryName}</a>
							</nav>
							<h1>{title}</h1>
						<p class="meta">
							LEO · <FormattedDate date={pubDate} />
							{updatedDate && <span> · {ui.updated} <FormattedDate date={updatedDate} /></span>}
						</p>
						<div class="tick"></div>
					</div>
					{!post.reviewed && ui.notice && <p class="tr-preview">{ui.notice.preview}</p>}
					{
						keyPoints && keyPoints.length > 0 && (
							<section class="key-points" aria-labelledby="key-points-title">
								<h2 id="key-points-title">{ui.keyPoints}</h2>
								<ul>
									{keyPoints.map((point) => (
										<li>{point}</li>
									))}
								</ul>
							</section>
						)
					}
					<slot />
				</div>
				<ShareButtons url={shareUrl} title={title} />
				<AuthorBox />
			</article>

			{
				related.length > 0 && (
					<section class="wrap related">
						<h2 class="sec-head">{ui.related}</h2>
						<div class="rel-grid">
							{related.map((p) => (
								<PostCard post={p} />
							))}
						</div>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		position: relative;
		max-width: 980px;
		margin: 2.4rem auto 0;
		aspect-ratio: 16 / 9;
		border: 1px solid #000;
		overflow: hidden;
	}
	.hero :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.post-head {
		text-align: center;
		padding: 2.4rem 0 0.5rem;
	}
	.post-head h1 {
		font-size: 32px;
		line-height: 1.32;
		margin: 0.4em 0 0.5em;
	}
	.post-head .meta {
		margin-bottom: 0;
		text-align: center;
	}
	.tick {
		width: 56px;
		border-top: 2px solid #000;
		margin: 1.5rem auto 0.5rem;
	}
	.related {
		margin-top: 4.5rem;
		border-top: 3px solid #000;
		padding-top: 1.6rem;
	}
	.rel-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}
	@media (max-width: 620px) {
		.rel-grid {
			grid-template-columns: 1fr;
		}
		.post-head h1 {
			font-size: 26px;
		}
	}
	.crumbs {
		font-size: 13px;
		letter-spacing: 0.02em;
		margin-bottom: 0.6rem;
	}
	.crumbs a {
		color: #000;
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	.crumbs a:hover {
		border-bottom-color: #000;
	}
	.crumbs span {
		margin: 0 0.4em;
		color: #666;
	}
	/* 미리보기 배포에서만 — 검수 전 번역본 표시 (운영에는 검수 전 번역이 나가지 않는다) */
	.tr-preview {
		font-size: 13px;
		font-weight: 700;
		color: var(--ink);
		border: 1px solid var(--line-thin);
		padding: 8px 14px;
		margin: 0.6rem 0 1.8rem;
	}
	/* 핵심 요약 (2026-10-27) — 마이클리닉 글의 Key points 처럼 제목 아래 위아래 선 사이. 글자는 본문보다 한 단계 작게 */
	.key-points {
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--line-thin);
		padding: 1.1rem 0 1.2rem;
		margin: 0.4rem 0 2.2rem;
	}
	.prose .key-points h2 {
		font-size: 15px;
		line-height: 1.4;
		margin: 0 0 0.6rem;
		padding: 0;
		border: 0;
	}
	.key-points ul {
		margin: 0;
		padding-left: 1.2em;
	}
	.key-points li {
		font-size: 15px;
		line-height: 1.7;
		margin: 0 0 0.45rem;
	}
	.key-points li:last-child {
		margin-bottom: 0;
	}
</style>
