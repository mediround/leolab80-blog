---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { Icon } from 'astro-icon/components';
import ProfileImage from '../assets/profile-leo.jpg';
import { AUTHOR, CATEGORY_SLUG, SOCIALS } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, category, heroImage } = Astro.props;

// 공유 링크에 쓸 이 글의 정식 URL(사이트 도메인 + 현재 경로)
const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();

// 이동 경로: 홈 → 카테고리 → (현재 글)
const categoryURL = new URL(`/category/${CATEGORY_SLUG[category]}/`, Astro.site).toString();
const breadcrumb = [
	{ name: '홈', url: new URL('/', Astro.site).toString() },
	{ name: category, url: categoryURL },
	{ name: title },
];

const all = await getCollection('blog');
const others = all.filter((p) => p.data.title !== title);
const same = others.filter((p) => p.data.category === category);
const rest = others.filter((p) => p.data.category !== category);
const related = [...same, ...rest]
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<html lang="ko">
	<head>
		<BaseHead
			title={`${title} — LEOLAB80`}
			description={description}
			image={heroImage}
			post={{ headline: title, pubDate, updatedDate, section: category }}
				breadcrumb={breadcrumb}
		/>
	</head>
	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero">
							<Image
								class="duotone"
								src={heroImage}
								width={1200}
								height={675}
								alt={title}
								loading="eager"
								fetchpriority="high"
							/>
							<span class="badge">{category}</span>
						</div>
					)
				}
				<div class="prose">
					<div class="post-head">
						<nav class="crumbs" aria-label="이동 경로">
								<a href="/">홈</a>
								<span aria-hidden="true">›</span>
								<a href={categoryURL}>{category}</a>
							</nav>
							<h1>{title}</h1>
						<p class="meta">
							LEO · <FormattedDate date={pubDate} />
							{updatedDate && <span> · 수정 <FormattedDate date={updatedDate} /></span>}
						</p>
						<div class="tick"></div>
					</div>
					<slot />
				</div>
				<ShareButtons url={shareUrl} title={title} />
				<aside class="author prose" aria-label="글쓴이">
					<a class="author-photo" href="/about/" aria-hidden="true" tabindex="-1">
						<Image src={ProfileImage} width={112} height={112} alt="LEO(신영종) 프로필 사진" />
					</a>
					<div>
						<p class="author-name">
							<a href="/about/">{AUTHOR.alternateName}</a>
							<span class="author-title">{AUTHOR.jobTitle}</span>
						</p>
						<p class="author-bio">{AUTHOR.bio}</p>
						<p class="author-links">
							<a class="more" href="/about/">LEO 소개 →</a>
							<span class="author-soc">
								<a href={SOCIALS.instagram} target="_blank" rel="noopener" aria-label="인스타그램"><Icon name="simple-icons:instagram" size={15} /></a>
								<a href={SOCIALS.x} target="_blank" rel="noopener" aria-label="엑스"><Icon name="simple-icons:x" size={14} /></a>
								<a href={SOCIALS.linkedin} target="_blank" rel="noopener" aria-label="링크드인"><Icon name="simple-icons:linkedin" size={15} /></a>
								<a href={SOCIALS.youtube} target="_blank" rel="noopener" aria-label="유튜브"><Icon name="simple-icons:youtube" size={15} /></a>
							</span>
						</p>
					</div>
				</aside>
			</article>

			{
				related.length > 0 && (
					<section class="wrap related">
						<h2 class="sec-head">함께 읽기</h2>
						<div class="rel-grid">
							{related.map((p) => (
								<PostCard post={p} />
							))}
						</div>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		position: relative;
		max-width: 980px;
		margin: 2.4rem auto 0;
		aspect-ratio: 16 / 9;
		border: 1px solid #000;
		overflow: hidden;
	}
	.hero :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.post-head {
		text-align: center;
		padding: 2.4rem 0 0.5rem;
	}
	.post-head h1 {
		font-size: 32px;
		line-height: 1.32;
		margin: 0.4em 0 0.5em;
	}
	.post-head .meta {
		margin-bottom: 0;
		text-align: center;
	}
	.tick {
		width: 56px;
		border-top: 2px solid #000;
		margin: 1.5rem auto 0.5rem;
	}
	.author {
		display: grid;
		grid-template-columns: 64px 1fr;
		gap: 20px;
		align-items: start;
		margin-top: 2.6rem;
		padding: 1.4rem 0 0;
		border-top: 1px solid var(--line-thin);
		font-size: 14px;
		line-height: 1.7;
	}
	.author-photo {
		display: block;
		width: 64px;
		height: 64px;
		border: 1px solid var(--ink);
		overflow: hidden;
	}
	.author-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.author-name {
		margin: 0 0 4px;
		font-weight: 700;
		font-size: 15px;
	}
	.author-title {
		margin-left: 10px;
		font-weight: 400;
		font-size: 12px;
		letter-spacing: 0.08em;
		color: var(--muted);
	}
	.author-bio {
		margin: 0 0 8px;
		text-align: left;
	}
	.author-links {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.author-soc {
		display: inline-flex;
		gap: 12px;
		align-items: center;
	}
	.author-soc a {
		display: inline-flex;
		align-items: center;
		color: var(--ink);
	}
	.related {
		margin-top: 4.5rem;
		border-top: 3px solid #000;
		padding-top: 1.6rem;
	}
	.rel-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}
	@media (max-width: 620px) {
		.rel-grid {
			grid-template-columns: 1fr;
		}
		.post-head h1 {
			font-size: 26px;
		}
	}
	.crumbs {
		font-size: 13px;
		letter-spacing: 0.02em;
		margin-bottom: 0.6rem;
	}
	.crumbs a {
		color: #000;
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	.crumbs a:hover {
		border-bottom-color: #000;
	}
	.crumbs span {
		margin: 0 0.4em;
		color: #666;
	}
</style>
