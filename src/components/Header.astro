---
import { CATEGORIES, CATEGORY_SLUG, SITE_TAGLINE, SITE_TITLE } from '../consts';
---

<header>
	<div class="wrap mast">
		<div class="mast-line"><a href="/" class="logo">{SITE_TITLE}</a></div>
		<div class="mast-line"><span class="tag">{SITE_TAGLINE}</span></div>
	</div>

	<nav class="nav" aria-label="카테고리">
		<!-- 휴대폰(720px 이하)에서만 보이는 메뉴 버튼 (2026-10-09 대표 요청). JS 가 꺼져 있으면 버튼은 숨고 링크가 그대로 펼쳐진다 -->
		<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
			<span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
			<span class="nav-toggle-label">메뉴</span>
		</button>
		<div class="wrap nav-in" id="nav-links">
			{
				CATEGORIES.map((c) => (
					<a href={`/category/${CATEGORY_SLUG[c]}/`}>{c}</a>
				))
			}
			<a href="/about/">LEO</a>
		</div>
	</nav>
</header>

<script is:inline>
	(function () {
		function fit() {
			var logo = document.querySelector('.mast .logo');
			var tag = document.querySelector('.mast .tag');
			if (!logo || !tag) return;
			logo.style.fontSize = '';
			var tagW = tag.getBoundingClientRect().width;
			var logoW = logo.getBoundingClientRect().width;
			if (logoW > 0 && tagW > 0) {
				var cur = parseFloat(getComputedStyle(logo).fontSize);
				logo.style.fontSize = (cur * tagW) / logoW + 'px';
			}
		}
		if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
		window.addEventListener('load', fit);
		window.addEventListener('resize', fit);
		fit();
	})();

	// 휴대폰 메뉴 열고 닫기 — has-js 가 붙어야만 CSS 가 링크를 접는다(스크립트 실패 시 메뉴가 사라지지 않게)
	(function () {
		var nav = document.querySelector('header .nav');
		var btn = nav && nav.querySelector('.nav-toggle');
		if (!btn) return;
		var label = btn.querySelector('.nav-toggle-label');
		nav.classList.add('has-js');
		function setOpen(open) {
			nav.classList.toggle('is-open', open);
			btn.setAttribute('aria-expanded', String(open));
			label.textContent = open ? '닫기' : '메뉴';
		}
		btn.addEventListener('click', function () {
			setOpen(!nav.classList.contains('is-open'));
		});
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && nav.classList.contains('is-open')) {
				setOpen(false);
				btn.focus();
			}
		});
	})();
</script>

<style>
	header {
		margin: 0;
	}
	.util {
		border-bottom: 1px solid #000;
	}
	.util-in {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 9px 0;
		font-size: 11px;
		letter-spacing: 0.14em;
	}
	.soc a {
		margin-left: 14px;
		display: inline-flex;
		align-items: center;
		color: #000;
	}
	.mast {
		text-align: center;
		padding: 40px 0 14px;
	}
	.mast-line {
		text-align: center;
		line-height: 1;
	}
	.logo {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 52px; /* JS가 태그라인 폭에 맞춰 재조정 */
		letter-spacing: 0; /* 철자 붙임 */
		line-height: 1;
		display: inline-block;
		color: #000;
	}
	.tag {
		display: inline-block;
		white-space: nowrap;
		font-size: 13px;
		font-weight: 400;
		margin-top: 12px;
	}
	.nav {
		border-top: 1px solid #000;
		border-bottom: 2px solid #000;
		margin-top: 18px;
	}
	.nav-in {
		display: flex;
		justify-content: center;
		gap: 34px;
		padding: 13px 0;
		font-size: 13px;
		letter-spacing: 0.12em;
		font-weight: 500;
	}
	.nav-in a {
		color: #000;
	}
	.nav-toggle {
		display: none;
	}
	@media (max-width: 720px) {
		/* JS 가 없을 때의 대체 모양(예전과 같음) */
		.nav-in {
			gap: 18px;
			font-size: 12px;
			flex-wrap: wrap;
		}
		.nav.has-js .nav-toggle {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			width: 100%;
			padding: 13px 0;
			border: 0;
			border-radius: 0;
			background: none;
			color: #000;
			font: inherit;
			font-size: 12px;
			font-weight: 500;
			letter-spacing: 0.12em;
			cursor: pointer;
		}
		.burger {
			display: inline-flex;
			flex-direction: column;
			justify-content: space-between;
			width: 16px;
			height: 11px;
		}
		.burger span {
			display: block;
			height: 1.5px;
			background: #000;
			transition: transform 0.2s ease, opacity 0.2s ease;
		}
		.nav.is-open .burger span:nth-child(1) {
			transform: translateY(4.75px) rotate(45deg);
		}
		.nav.is-open .burger span:nth-child(2) {
			opacity: 0;
		}
		.nav.is-open .burger span:nth-child(3) {
			transform: translateY(-4.75px) rotate(-45deg);
		}
		.nav.has-js .nav-in {
			display: none;
		}
		.nav.has-js.is-open .nav-in {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0 0 4px;
			border-top: 1px solid var(--line-thin);
		}
		.nav.has-js.is-open .nav-in a {
			display: block;
			padding: 13px 0;
			text-align: center;
		}
		.nav.has-js.is-open .nav-in a + a {
			border-top: 1px solid var(--line-thin);
		}
	}
</style>
