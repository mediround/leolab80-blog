---
// 페이지네이션 (구조 v0.2 · 2026-09-05)
interface Props {
	current: number;
	last: number;
	prevUrl?: string;
	nextUrl?: string;
	hrefFor: (n: number) => string;
}
import { splitLangPath, t } from '../i18n';
const { current, last, prevUrl, nextUrl, hrefFor } = Astro.props;
const ui = t(splitLangPath(Astro.url.pathname).lang);
const pages = Array.from({ length: last }, (_, i) => i + 1);
---

{
	last > 1 && (
		<nav class="pager" aria-label={ui.pagerLabel}>
			{prevUrl ? <a href={prevUrl}>{ui.prev}</a> : <span class="off">{ui.prev}</span>}
			{pages.map((n) => (n === current ? <b aria-current="page">{n}</b> : <a href={hrefFor(n)}>{n}</a>))}
			{nextUrl ? <a href={nextUrl}>{ui.next}</a> : <span class="off">{ui.next}</span>}
		</nav>
	)
}

<style>
	.pager {
		display: flex;
		justify-content: center;
		gap: 18px;
		padding: 2rem 0 0.5rem;
		font-size: 13px;
		letter-spacing: 0.1em;
	}
	.pager a {
		color: var(--ink);
	}
	.pager b {
		border-bottom: 2px solid var(--ink);
	}
	.off {
		color: #bbb;
	}
</style>
