---
// 저자 칸 — 포스트 하단과 LEO 소개 페이지 하단이 함께 쓴다 (2026-10-07 BlogPost 에서 분리, 마크업·스타일 그대로)
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ProfileImage from '../assets/profile-leo.jpg';
import { AUTHOR, SOCIALS } from '../consts';

interface Props {
	/** 「LEO 소개 →」 링크 표시 — 소개 페이지 자신에서는 끈다 */
	showAboutLink?: boolean;
}
const { showAboutLink = true } = Astro.props;
---

<aside class="author prose" aria-label="글쓴이">
	<a class="author-photo" href="/about/" aria-hidden="true" tabindex="-1">
		<Image src={ProfileImage} width={112} height={112} alt="LEO(신영종) 프로필 사진" />
	</a>
	<div>
		<p class="author-name">
			<a href="/about/">{AUTHOR.alternateName}</a>
			<span class="author-title">{AUTHOR.jobTitle}</span>
		</p>
		<p class="author-bio">{AUTHOR.bio}</p>
		<p class="author-links">
			{showAboutLink && <a class="more" href="/about/">LEO 소개 →</a>}
			<span class="author-soc">
				<a href={SOCIALS.instagram} target="_blank" rel="noopener" aria-label="인스타그램"><Icon name="simple-icons:instagram" size={15} /></a>
				<a href={SOCIALS.x} target="_blank" rel="noopener" aria-label="엑스"><Icon name="simple-icons:x" size={14} /></a>
				<a href={SOCIALS.linkedin} target="_blank" rel="noopener" aria-label="링크드인"><Icon name="simple-icons:linkedin" size={15} /></a>
				<a href={SOCIALS.youtube} target="_blank" rel="noopener" aria-label="유튜브"><Icon name="simple-icons:youtube" size={15} /></a>
			</span>
		</p>
	</div>
</aside>

<style>
	.author {
		display: grid;
		grid-template-columns: 64px 1fr;
		gap: 20px;
		align-items: start;
		margin-top: 2.6rem;
		padding: 1.4rem 0 0;
		border-top: 1px solid var(--line-thin);
		font-size: 14px;
		line-height: 1.7;
	}
	.author-photo {
		display: block;
		width: 64px;
		height: 64px;
		border: 1px solid var(--ink);
		overflow: hidden;
	}
	.author-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.author-name {
		margin: 0 0 4px;
		font-weight: 700;
		font-size: 15px;
	}
	.author-title {
		margin-left: 10px;
		font-weight: 400;
		font-size: 12px;
		letter-spacing: 0.08em;
		color: var(--muted);
	}
	.author-bio {
		margin: 0 0 8px;
		text-align: left;
	}
	.author-links {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.author-soc {
		display: inline-flex;
		gap: 12px;
		align-items: center;
	}
	.author-soc a {
		display: inline-flex;
		align-items: center;
		color: var(--ink);
	}
</style>
