---
// 홈·카테고리 세로 리스트 1건 (구조 v0.2 · 2026-09-05)
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { AUTHOR, CATEGORY_SLUG } from '../consts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, category, pubDate, heroImage } = post.data;
---

<article class="item">
	<a class="thumb" href={`/blog/${post.id}/`} aria-hidden="true" tabindex="-1">
		{heroImage ? <Image class="duotone" src={heroImage} width={520} height={390} alt="" /> : <div class="ghost-img">대표이미지</div>}
	</a>
	<div class="body">
		<p class="meta">
			<a class="cat" href={`/category/${CATEGORY_SLUG[category]}/`}>{category}</a>
			<span class="dot">·</span>
			<FormattedDate date={pubDate} />
			<span class="dot">·</span>
			<span>{AUTHOR.alternateName}</span>
		</p>
		<h2 class="title"><a href={`/blog/${post.id}/`}>{title}</a></h2>
		<p class="desc">{description}</p>
	</div>
</article>

<style>
	.item {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: 28px;
		padding: 26px 0;
		border-bottom: 1px solid var(--line-thin);
	}
	.thumb {
		display: block;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--line);
		overflow: hidden;
		background: #f2f2f2;
	}
	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.ghost-img {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		font-size: 12px;
	}
	.meta {
		margin: 0 0 8px;
	}
	.cat {
		color: var(--ink);
		font-weight: 700;
	}
	.dot {
		margin: 0 6px;
	}
	.title {
		font-size: 22px;
		line-height: 1.4;
		margin: 0 0 10px;
	}
	.title a {
		color: var(--ink);
	}
	.desc {
		margin: 0;
		color: #333;
		font-size: 15px;
		line-height: 1.7;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (max-width: 720px) {
		.item {
			grid-template-columns: 1fr;
			gap: 14px;
		}
	}
</style>
