---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import {
	AUTHOR,
	GSC_VERIFICATION,
	NAVER_VERIFICATION,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SOCIALS,
} from '../consts';
import { Font } from 'astro:assets';
import GoogleAnalytics from './GoogleAnalytics.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
	// 글 페이지에서만 전달 — og:type=article 및 BlogPosting JSON-LD 활성화
	post?: { headline: string; pubDate: Date; updatedDate?: Date };
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = Astro.site?.toString() ?? 'https://mediseed.kr/';
const aboutURL = new URL('/about/', Astro.site).toString();
const logoURL = new URL('/logo.png', Astro.site).toString();

const { title, description, image = FallbackImage, imageAlt = title, post } = Astro.props;
const ogImage = new URL(image.src, Astro.site).toString();
const isHome = Astro.url.pathname === '/';
const socials = Object.values(SOCIALS);

// 저자·발행처 엔티티(글 JSON-LD와 홈 Organization에서 공유)
const author = {
	'@type': 'Person',
	name: AUTHOR.name,
	alternateName: AUTHOR.alternateName,
	url: aboutURL,
	sameAs: socials,
};
const orgLogo = { '@type': 'ImageObject', url: logoURL };

// 홈에서만: Organization + WebSite (브랜드 실체·GEO 앵커)
const siteJsonLd = isHome && {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${siteURL}#organization`,
			name: SITE_TITLE,
			url: siteURL,
			logo: orgLogo,
			description: SITE_DESCRIPTION,
			sameAs: socials,
			founder: author,
		},
		{
			'@type': 'WebSite',
			'@id': `${siteURL}#website`,
			name: SITE_TITLE,
			url: siteURL,
			description: SITE_DESCRIPTION,
			inLanguage: 'ko',
			publisher: { '@id': `${siteURL}#organization` },
		},
	],
};

const jsonLd = post && {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.headline,
	description,
	url: canonicalURL.toString(),
	mainEntityOfPage: canonicalURL.toString(),
	image: ogImage,
	datePublished: post.pubDate.toISOString(),
	dateModified: (post.updatedDate ?? post.pubDate).toISOString(),
	inLanguage: 'ko',
	author,
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: siteURL,
		logo: orgLogo,
	},
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

{GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
{NAVER_VERIFICATION && <meta name="naver-site-verification" content={NAVER_VERIFICATION} />}

<Font cssVariable="--font-sans" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={post ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
{post && <meta property="article:published_time" content={post.pubDate.toISOString()} />}
{post?.updatedDate && <meta property="article:modified_time" content={post.updatedDate.toISOString()} />}

{siteJsonLd && <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<GoogleAnalytics />
