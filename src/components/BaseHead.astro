---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/og-home.jpg'; // 홈·목록·소개 기본 공유 이미지 = 브랜드 타이포 카드 (2026-09-13, 구 blog-placeholder-1)
import ProfileImage from '../assets/profile-leo.jpg';
import {
	AUTHOR,
	GSC_VERIFICATION,
	NAVER_VERIFICATION,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SOCIALS,
} from '../consts';
import GoogleAnalytics from './GoogleAnalytics.astro';
import { LANG_META, type Lang, localizePath, splitLangPath, t } from '../i18n';
import { getAlternates } from '../lib/posts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
	// 글 페이지에서만 전달 — og:type=article 및 BlogPosting JSON-LD 활성화
	post?: { headline: string; pubDate: Date; updatedDate?: Date; section?: string };
	// 이동 경로(홈→카테고리→글). 마지막 항목은 url 생략(현재 페이지)
	breadcrumb?: { name: string; url?: string }[];
	// 얇은 페이지(빈 카테고리 등)를 색인에서 제외. 내용이 생기면 호출부에서 자동 해제.
	noindex?: boolean;
	// 번역본이면 한국어 원문 주소 (BlogPosting.translationOfWork)
	translationOf?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = Astro.site?.toString() ?? 'https://mediseed.kr/';
// 언어 = 주소 앞부분(/en · /zh). 한국어 주소는 예전 그대로 (2026-10-14 다국어)
const { lang, basePath } = splitLangPath(Astro.url.pathname);
const meta = LANG_META[lang];
const ui = t(lang);
const { hreflang } = await getAlternates(basePath);
const hreflangLinks = (Object.keys(hreflang) as Lang[]).map((l) => ({
	hreflang: LANG_META[l].hreflang,
	href: new URL(hreflang[l]!, Astro.site).toString(),
}));
const xDefault = hreflang.ko ? new URL(hreflang.ko, Astro.site).toString() : undefined;
const ogAlternates = (Object.keys(hreflang) as Lang[]).filter((l) => l !== lang).map((l) => LANG_META[l].ogLocale);
const aboutURL = new URL(localizePath('/about/', lang), Astro.site).toString();
const logoURL = new URL('/logo.png', Astro.site).toString();

const { title, description, image = FallbackImage, imageAlt = title, post, breadcrumb, noindex, translationOf } = Astro.props;
const ogImage = new URL(image.src, Astro.site).toString();
const isHome = Astro.url.pathname === '/';
const socials = Object.values(SOCIALS);

// 저자·발행처 엔티티(글 JSON-LD와 홈 Organization에서 공유)
const author = {
	'@type': 'Person',
	name: AUTHOR.name,
	alternateName: AUTHOR.alternateName,
	url: aboutURL,
	jobTitle: ui.author.jobTitle,
	image: new URL(ProfileImage.src, Astro.site).toString(),
	worksFor: { '@type': 'Organization', name: AUTHOR.worksFor.name, url: AUTHOR.worksFor.url },
	knowsAbout: AUTHOR.knowsAbout,
	sameAs: socials,
};
const orgLogo = { '@type': 'ImageObject', url: logoURL };

// 홈에서만: Organization + WebSite (브랜드 실체·GEO 앵커)
const siteJsonLd = isHome && {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${siteURL}#organization`,
			name: SITE_TITLE,
			url: siteURL,
			logo: orgLogo,
			description: SITE_DESCRIPTION,
			sameAs: socials,
			founder: author,
		},
		{
			'@type': 'WebSite',
			'@id': `${siteURL}#website`,
			name: SITE_TITLE,
			url: siteURL,
			description: SITE_DESCRIPTION,
			inLanguage: 'ko',
			publisher: { '@id': `${siteURL}#organization` },
		},
	],
};

const jsonLd = post && {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.headline,
	description,
	url: canonicalURL.toString(),
	mainEntityOfPage: canonicalURL.toString(),
	image: ogImage,
	datePublished: post.pubDate.toISOString(),
	dateModified: (post.updatedDate ?? post.pubDate).toISOString(),
	inLanguage: meta.htmlLang,
	...(translationOf ? { translationOfWork: { '@type': 'BlogPosting', url: translationOf, inLanguage: 'ko' } } : {}),
	author,
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: siteURL,
		logo: orgLogo,
	},
};

const breadcrumbLd = breadcrumb &&
	breadcrumb.length > 0 && {
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: breadcrumb.map((b, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: b.name,
			...(b.url ? { item: b.url } : {}),
		})),
	};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

{GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
{NAVER_VERIFICATION && <meta name="naver-site-verification" content={NAVER_VERIFICATION} />}

<!-- 폰트: 외부 스타일시트로 로드 — 인라인 @font-face 235KB가 매 페이지 반복되던 것을 캐시 가능한 링크로 대체 (2026-09-01 SEO 감사) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap"
/>
{/* 중국어(간체) 페이지만: 간체 글자가 한국어 폰트에 없으면 시스템 글꼴과 섞이므로 간체 폰트를 따로 받는다 */}
{
	lang === 'zh' && (
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap" />
	)
}

{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{/* 언어별 같은 페이지 (자기 자신 포함 · 기본 = 한국어 원문) */}
{hreflangLinks.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={`${AUTHOR.name} (${AUTHOR.alternateName})`} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={post ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={meta.ogLocale} />
{ogAlternates.map((o) => <meta property="og:locale:alternate" content={o} />)}
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
{post && <meta property="article:published_time" content={post.pubDate.toISOString()} />}
{post && <meta property="article:author" content={aboutURL} />}
{post?.section && <meta property="article:section" content={post.section} />}
{post?.section && <meta property="article:tag" content={post.section} />}
{post?.updatedDate && <meta property="article:modified_time" content={post.updatedDate.toISOString()} />}

{siteJsonLd && <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
{breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<GoogleAnalytics />
