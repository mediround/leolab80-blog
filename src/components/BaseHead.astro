---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { AUTHOR, GSC_VERIFICATION, NAVER_VERIFICATION, SITE_TITLE, SOCIALS } from '../consts';
import { Font } from 'astro:assets';
import GoogleAnalytics from './GoogleAnalytics.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	// 글 페이지에서만 전달 — og:type=article 및 BlogPosting JSON-LD 활성화
	post?: { headline: string; pubDate: Date; updatedDate?: Date };
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage, post } = Astro.props;

const jsonLd = post && {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.headline,
	description,
	url: canonicalURL.toString(),
	mainEntityOfPage: canonicalURL.toString(),
	image: new URL(image.src, Astro.site).toString(),
	datePublished: post.pubDate.toISOString(),
	dateModified: (post.updatedDate ?? post.pubDate).toISOString(),
	inLanguage: 'ko',
	author: {
		'@type': 'Person',
		name: AUTHOR.name,
		alternateName: AUTHOR.alternateName,
		url: new URL('/about/', Astro.site).toString(),
		sameAs: Object.values(SOCIALS),
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: Astro.site?.toString(),
	},
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

{GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
{NAVER_VERIFICATION && <meta name="naver-site-verification" content={NAVER_VERIFICATION} />}

<Font cssVariable="--font-sans" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={post ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
{post && <meta property="article:published_time" content={post.pubDate.toISOString()} />}
{post?.updatedDate && <meta property="article:modified_time" content={post.updatedDate.toISOString()} />}

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />

<GoogleAnalytics />
