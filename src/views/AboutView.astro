---
// LEO 소개 페이지 — 언어별 공용. 한국어 본문 = 대표 확정 원고 그대로(2026-10-07), 번역 = src/i18n.ts (2026-10-14)
import BaseHead from '../components/BaseHead.astro';
import AuthorBox from '../components/AuthorBox.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProfileImage from '../assets/profile-leo.jpg';
import { AUTHOR, SITE_TITLE, SOCIALS } from '../consts';
import { LANG_META, type Lang, localizePath, t } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);

// 저자 엔티티(E-E-A-T·GEO)
const personLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	...(lang === 'ko' ? {} : { inLanguage: LANG_META[lang].htmlLang }),
	mainEntity: {
		'@type': 'Person',
		name: AUTHOR.name,
		alternateName: AUTHOR.alternateName,
		url: new URL(localizePath('/about/', lang), Astro.site).toString(),
		image: new URL(ProfileImage.src, Astro.site).toString(),
		jobTitle: ui.author.jobTitle,
		// 예전 about.astro 는 worksFor 를 두 번 적어 뒤의 값(LEOLAB80)이 실제로 나갔다 — 출력이 바뀌지 않게 그 값만 둔다
		worksFor: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.toString() },
		sameAs: Object.values(SOCIALS),
	},
};
---

<!doctype html>
<html lang={LANG_META[lang].htmlLang}>
	<head>
		<BaseHead title={`LEO — ${SITE_TITLE}`} description={ui.aboutDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
	</head>
	<body>
		<Header />
		<main class="prose about">
			<div class="post-head">
				<h1>LEO</h1>
				<div class="tick"></div>
			</div>
			{ui.about.map((para) => <p>{para}</p>)}
		</main>
		<AuthorBox showAboutLink={false} />
		<ContactForm />
		<Footer />
	</body>
</html>

<style>
	.about {
		padding-top: 1rem;
		min-height: 40vh;
	}
	.post-head {
		text-align: center;
		padding: 2.4rem 0 1.5rem;
	}
	.post-head h1 {
		font-family: var(--font-display);
		font-size: 40px;
		letter-spacing: 0.16em;
		margin: 0.3em 0 0.5em;
	}
	.tick {
		width: 56px;
		border-top: 2px solid #000;
		margin: 1.4rem auto 0;
	}
</style>
