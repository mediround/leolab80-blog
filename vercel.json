{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"redirects": [
		{ "source": "/feed", "destination": "/rss.xml", "statusCode": 301 },
		{ "source": "/feed/", "destination": "/rss.xml", "statusCode": 301 },
		{ "source": "/:path*/feed", "destination": "/rss.xml", "statusCode": 301 },
		{ "source": "/:path*/feed/", "destination": "/rss.xml", "statusCode": 301 }
	]
}
